<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-checks the Windows client on machines without the Windows Desktop SDK
    (Linux CI, the cloud sessions this was written in). It compiles the same
    sources against the WPF / WinRT reference assemblies downloaded from NuGet.
    On Windows, build Pip/Pip.csproj instead.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Pip</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DesktopRef>$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref/8.0.31/ref/net8.0/</DesktopRef>
    <WinSdkRef>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/10.0.19041.57/lib/net8.0/</WinSdkRef>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[8.0.31]" />
    <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.19041.57]" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Reference Include="$(DesktopRef)*.dll" />
    <Reference Include="$(WinSdkRef)*.dll" />
    <Compile Include="..\Pip\**\*.cs" Exclude="..\Pip\obj\**;..\Pip\bin\**" />
    <ProjectReference Include="..\Pip.Core\Pip.Core.csproj" />
  </ItemGroup>
</Project>
