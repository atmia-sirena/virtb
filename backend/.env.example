# Pip needs no API keys: every model runs locally and open source.
# Optional overrides:
# PIP_PORT=8787
# OLLAMA_HOST_URL=http://127.0.0.1:11434
# PIP_MODELS_DIR=D:\pip-models            (speech models; default %APPDATA%\Pip\models)
# PIP_SEARXNG_URL=http://127.0.0.1:8888    (self-hosted SearXNG; default DuckDuckGo, no key)
# PIP_CUA_DRIVER=cua-driver                (path to Cua Driver, MIT)
# PIP_CODEX_PATH=                          (path to Codex CLI, Apache-2.0; default: npm global)
# PIP_CODEX_SANDBOX=workspace-write
