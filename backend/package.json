{
  "name": "pip-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pip local backend: HeyClicky's thin Worker design on localhost:8787, with every model (LLMs, vision, speech) running locally and open source.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "setup:speech": "tsx src/setup-speech.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.10.0",
    "sharp": "^0.34.4",
    "sherpa-onnx-node": "^1.13.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
